# Production settings for https://cvstudy.in/astrology
# Copy this file to ".env" in the application root on the server and fill in the blanks.
# Never commit or publish the real .env file.

APP_NAME=vedic-astrology
APP_VERSION=1.2.0
APP_ENV=production
APP_BASE_PATH=/astrology
APP_PUBLIC_URL=https://cvstudy.in/astrology
# Both spellings of the domain are accepted; requests from anywhere else are rejected.
ALLOWED_CORS_ORIGINS=https://cvstudy.in,https://www.cvstudy.in
TRUSTED_HOSTS=cvstudy.in,www.cvstudy.in

# MySQL database created in cPanel (names include your cPanel username prefix)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# The built website pages inside this package
FRONTEND_DIST=frontend_dist

# Public repository of this app's source code (required by the AGPL licence).
# The footer's "Source code" link redirects here.
SOURCE_CODE_URL=

SESSION_COOKIE_NAME=vedic_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_PATH=/astrology/
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# New self-registered accounts must be approved by an administrator.
REQUIRE_ADMIN_APPROVAL=true
# Email verification needs a working mail server (SMTP below). Leave false until SMTP is set up.
REQUIRE_VERIFIED_EMAIL=false
VERIFICATION_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30

# Optional: a cvstudy.in mailbox from cPanel > Email Accounts > Connect Devices.
# Needed for "forgot password" emails. Port 465 uses SSL; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# "moshier" needs no data files. Use "swiss" only after uploading .se1 files to ASTROLOGY_EPHE_PATH.
ASTROLOGY_EPHEMERIS_SOURCE=moshier
ASTROLOGY_EPHE_PATH=
PDF_MAX_BYTES=10485760
