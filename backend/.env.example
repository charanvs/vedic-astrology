APP_NAME=vedic-astrology
APP_VERSION=1.2.0
APP_ENV=development
APP_BASE_PATH=
APP_PUBLIC_URL=http://localhost:5173
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
APP_HOST=127.0.0.1
APP_PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vedic_astrology
DB_USER=vedic_app
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MIGRATION_DB_USER=vedic_migrator
MIGRATION_DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
TEST_DB_NAME=vedic_astrology_test
TEST_DB_USER=vedic_test
TEST_DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Swiss Ephemeris calculation settings. "moshier" is an explicit, file-free
# backend; use "swiss" only with official .se1 files in ASTROLOGY_EPHE_PATH.
ASTROLOGY_EPHEMERIS_SOURCE=moshier
ASTROLOGY_EPHE_PATH=
ASTROLOGY_STATIONARY_THRESHOLD=0.0001
PDF_DLL_DIRECTORIES=C:\msys64\mingw64\bin
PDF_MAX_BYTES=10485760
SESSION_COOKIE_NAME=vedic_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_PATH=/
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
VERIFICATION_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
REQUIRE_VERIFIED_EMAIL=true
# Self-registered accounts cannot sign in until an administrator approves them.
REQUIRE_ADMIN_APPROVAL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
